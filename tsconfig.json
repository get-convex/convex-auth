{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowJs": true,
    "jsx": "react-jsx",
    "isolatedModules": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["src/lib/**/*", "src/components/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "examples",
    "prototype",
    "docs",
    "test",
    "test-router",
    "test-nextjs"
  ]
}
