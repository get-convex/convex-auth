{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // NodeNext resolution makes extensionless relative imports a compile
    // error (TS2835). tsc copies specifiers into `dist/` verbatim, so imports
    // must be written with the `.js` extension the emitted file will need;
    // this is what enforces that, in the editor and in `tsc --noEmit` alike.
    // The build config overrides back to Bundler for emit — same split as
    // the other Convex components (workpool, rate-limiter, better-auth).
    "module": "Node16",
    "moduleResolution": "NodeNext",
    // `vite/client` types the `import.meta.glob` that convex-test relies on.
    "types": ["node", "vite/client"]
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules"]
}
