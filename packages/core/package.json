{
  "name": "@convex-dev/auth",
  "version": "2.0.0-alpha.0",
  "description": "Authentication for Convex",
  "keywords": [
    "auth",
    "authentication",
    "authorization",
    "convex",
    "login",
    "sign"
  ],
  "homepage": "https://labs.convex.dev/auth",
  "bugs": "https://github.com/get-convex/convex-auth/issues",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/get-convex/convex-auth.git",
    "directory": "packages/core"
  },
  "bin": {
    "@convex-dev/auth": "./dist/cli/init.js"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./lib/*": "./src/lib/*.ts",
    "./core/convex.config.js": "./src/components/core/convex.config.ts",
    "./core/*": "./src/components/core/*.ts",
    "./providers/anonymous/convex.config.js": "./src/components/anonymous/convex.config.ts",
    "./providers/anonymous/react": "./src/components/anonymous/react.tsx",
    "./providers/anonymous/*": "./src/components/anonymous/*.ts",
    "./providers/password/convex.config.js": "./src/components/password/convex.config.ts",
    "./providers/password/react": "./src/components/password/react.tsx",
    "./providers/password/*": "./src/components/password/*.ts",
    "./providers/testing/*": "./src/components/testing/*.ts",
    "./browser": "./src/browser/index.ts",
    "./server": "./src/server/index.ts",
    "./react": "./src/react/index.tsx"
  },
  "scripts": {
    "build:cli": "tsc -p tsconfig.cli.json",
    "prepare": "pnpm build:cli",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@convex-dev/rate-limiter": "^0.3.2",
    "argon2id-wasm": "0.0.0-alpha.1",
    "commander": "^14.0.2",
    "jose": "^5.2.2"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.12.4",
    "@types/react": "^19.2.17",
    "convex": "^1.41.0",
    "convex-test": "^0.0.53",
    "hash-wasm": "^4.12.0",
    "jsdom": "^29.1.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.0"
  },
  "peerDependencies": {
    "convex": "^1.41.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
